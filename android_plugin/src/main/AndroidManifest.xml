<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13 以上發通知要先問使用者 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 重新開機後系統鬧鐘會清掉，要重新排 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.IslogNotify"
            android:value="io.github.corgi8cm.islog.notify.IslogNotify" />

        <receiver
            android:name="io.github.corgi8cm.islog.notify.NotifyReceiver"
            android:exported="false" />

        <receiver
            android:name="io.github.corgi8cm.islog.notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
